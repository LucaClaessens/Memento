{
  "name": "memento",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Personal support tool: remembering people, spotting overload, timeline of patterns, parking ideas.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @memento/web dev",
    "dev:api": "pnpm --filter @memento/api dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.12.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "typescript-eslint": "^8.15.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
