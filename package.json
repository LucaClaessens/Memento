{
  "name": "memento",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Personal support tool: remembering people, spotting overload, timeline of patterns, parking ideas.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @memento/web dev",
    "dev:api": "pnpm --filter @memento/api dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "0.2.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "oxlint": "1.95.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "tsrs": "7.1.0-beta.tsrs5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9.15.0"
  },
  "volta": {
    "node": "22.23.5"
  }
}
