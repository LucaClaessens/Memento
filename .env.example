# Environment variables for Memento.
# Copy to .env and fill in. Never commit .env.

# API
PORT=8787
MEMENTO_API_TOKEN=change-me
# Relative paths resolve from apps/api (the API's working directory).
MEMENTO_DB_PATH=./data/memento.db
# Comma-separated browser origins allowed to call the API.
MEMENTO_WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Parakeet (sherpa-onnx native addon + persistent worker)
MEMENTO_MODELS_DIR=./data/models
TRANSCRIBE_THREADS=4

# Web (copy to apps/web/.env — Vite reads env from the web package root)
# PUBLIC_API_URL=http://localhost:8787
